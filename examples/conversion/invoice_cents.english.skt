# Calculate an invoice in integer cents to avoid rounding in money totals.
# Return None for invalid quantities, prices, or discounts.
func invoice_total_cents(lines, discount_cents):
    subtotal := 0
    for line in lines:
        if line["quantity"] < 0 or line["unit_cents"] < 0:
            return None
        subtotal += line["quantity"] * line["unit_cents"]
    if discount_cents < 0 or discount_cents > subtotal:
        return None
    return subtotal - discount_cents

lines := [
    {"sku": "NOTEBOOK", "quantity": 3, "unit_cents": 1299},
    {"sku": "PEN", "quantity": 5, "unit_cents": 175},
]
total := invoice_total_cents(lines, 250)
if total is None:
    print("Invalid invoice")
else:
    print("Invoice total (cents):", total)
