{
  "name": "sanskrit-repl-syntax",
  "displayName": "Sanskrit REPL",
  "description": "Syntax highlighting, language server features, and English-to-Sanskrit source conversion.",
  "version": "0.3.0",
  "publisher": "local-sanskrit",
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./extension.js",
  "activationEvents": ["onLanguage:sanskrit-repl"],
  "categories": ["Programming Languages"],
  "contributes": {
    "commands": [
      {
        "command": "sanskritRepl.convertToSanskrit",
        "title": "Sanskrit REPL: Convert English Syntax to Sanskrit"
      }
    ],
    "configuration": {
      "title": "Sanskrit REPL",
      "properties": {
        "sanskritRepl.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python command used to run the Sanskrit language server."
        }
      }
    },
    "configurationDefaults": {
      "cSpell.enabledFileTypes": {
        "*": true,
        "markdown": true,
        "sanskrit-repl": false
      }
    },
    "languages": [
      {
        "id": "sanskrit-repl",
        "aliases": ["Sanskrit REPL", "Sanskrit"],
        "extensions": [".skt", ".sanskrit"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sanskrit-repl",
        "scopeName": "source.sanskrit-repl",
        "path": "./syntaxes/sanskrit-repl.tmLanguage.json"
      }
    ]
  }
}
